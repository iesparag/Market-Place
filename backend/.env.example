############################################################
#  Marketplace Backend — Environment Variables
#  Copy this file to `.env` and fill what you need.
#  Everything except MONGO_URI has a safe dev default, so
#  the app runs out-of-the-box; add keys to enable a feature.
############################################################

# ── Core ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (required in prod; dev default points to local Mongo)
MONGO_URI=mongodb://localhost:27017/marketplace

# Redis (queues/jobs — optional for now)
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ──────────────────────────────────────────
# CHANGE THESE IN PRODUCTION to long random strings.
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=86400        # access token life in seconds (1 day)
JWT_REFRESH_TTL=15552000    # refresh token life in seconds (180 days)

# ── URLs / CORS ─────────────────────────────────────────
WEB_ORIGIN=http://localhost:4200     # customer site (CORS + socket)
ADMIN_ORIGIN=http://localhost:4300   # admin dashboard
PUBLIC_URL=http://localhost:4000     # this API's public base (used for local image URLs)

# ── Image upload: Cloudinary (FREE, no card) ────────────
# Get from https://cloudinary.com dashboard. If unset → images save to local /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email: SMTP (Gmail) ─────────────────────────────────
# Order / OTP / password-reset / welcome emails.
# If unset → emails just log to the console (nothing is sent).
# Gmail setup: enable 2-Step Verification → create an "App password"
# (myaccount.google.com → Security → App passwords) → use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Marketplace <your@gmail.com>

# ── Push notifications: Firebase Cloud Messaging (FCM) ──
# For the future Flutter app + admin broadcasts. If unset → push is a no-op (logs).
# Firebase Console → Project settings → Service accounts →
# "Generate new private key" (downloads a JSON). Copy these 3 values from it.
# Keep the private key on ONE line with literal \n where the JSON had newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
