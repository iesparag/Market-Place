############################################################
#  Marketplace Backend — Environment Variables
#  Copy this file to `.env` and fill what you need.
#  Everything except MONGO_URI has a safe dev default, so
#  the app runs out-of-the-box; add keys to enable a feature.
############################################################

# ── Core ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (required in prod; dev default points to local Mongo)
MONGO_URI=mongodb://localhost:27017/marketplace

# Redis (queues/jobs — optional for now)
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ──────────────────────────────────────────
# CHANGE THESE IN PRODUCTION to long random strings.
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=86400        # access token life in seconds (1 day)
JWT_REFRESH_TTL=15552000    # refresh token life in seconds (180 days)

# ── URLs / CORS ─────────────────────────────────────────
WEB_ORIGIN=http://localhost:4200     # customer site (CORS + socket)
ADMIN_ORIGIN=http://localhost:4300   # admin dashboard
PUBLIC_URL=http://localhost:4000     # this API's public base (used for local image URLs)

# ── Image upload: Cloudinary (FREE, no card) ────────────
# Get from https://cloudinary.com dashboard. If unset → images save to local /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email: SMTP (Gmail) ─────────────────────────────────
# Order / OTP / password-reset / welcome emails.
# If nothing below is set → emails just log to the console (nothing is sent).
#
# PREFERRED — Resend (plain HTTPS, so it works on Railway/Render/Fly, which block
# outbound SMTP ports 25/465/587). Sign up at resend.com, create an API key, and set
# MAIL_FROM to an address on a domain you verified there (or onboarding@resend.dev to test).
# When RESEND_API_KEY is set it wins and the SMTP_* values below are ignored.
RESEND_API_KEY=
#
# FALLBACK — SMTP. Fine locally; on most PaaS hosts it will just time out.
# Gmail setup: enable 2-Step Verification → create an "App password"
# (myaccount.google.com → Security → App passwords) → use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Marketplace <your@gmail.com>

# ── Search engine ───────────────────────────────────────
# 'mongo' (default) = works on ANY MongoDB, no setup, free, zero lock-in.
# 'atlas' = MongoDB Atlas Search (better fuzzy/typo-tolerance) — needs search indexes
#           named "default" (products) + "stores" (stores) created in Atlas first.
SEARCH_ENGINE=mongo

# ── AI customer support (docs/10-SUPPORT-AI.md) ─────────
# The support bot answers order questions (RAG + your own order data) and escalates
# anything privileged (refunds) to a human. If OPENAI_API_KEY is unset, the bot runs on
# a deterministic stub so the whole feature works keyless in dev (real LLM wiring = phase S2).
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBED_MODEL=text-embedding-3-small
# RAG vector store: 'mongo' (in-app cosine, any MongoDB — dev default) or 'atlas'
# ($vectorSearch — create a vector index on the kb_chunks.embedding field in Atlas first).
VECTOR_ENGINE=mongo
SUPPORT_RATE_PER_MIN=20

# ── Push notifications: Firebase Cloud Messaging (FCM) ──
# For the future Flutter app + admin broadcasts. If unset → push is a no-op (logs).
# Firebase Console → Project settings → Service accounts →
# "Generate new private key" (downloads a JSON). Copy these 3 values from it.
# Keep the private key on ONE line with literal \n where the JSON had newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Mobile app (Flutter) — served at GET /api/v1/app/config ──
# Version gate: the app compares its build version to APP_MIN_VERSION on launch.
# If the installed app is older → it shows a blocking "Update required" screen.
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_UPDATE_URL=                 # Play Store / APK / Drive link (opened by the "Update now" button)
APP_UPDATE_MESSAGE=A new version is available. Please update to continue.

# ── Payments: Razorpay (India — UPI, cards, netbanking, wallets) ──
# docs/05-PAYMENTS.md. Leave these blank in dev: the app falls back to a keyless MOCK
# gateway that exercises the whole flow (checkout → signature → ledger → refund) without
# an account. Set them and it switches to the real gateway automatically.
#
#   1. Sign up at https://dashboard.razorpay.com (free; no monthly fee).
#   2. Settings → API Keys → Generate Test Key. Copy both halves below.
#   3. Settings → Webhooks → Add New Webhook:
#        URL     https://<your-api-host>/api/v1/webhooks/razorpay
#        Secret  <invent one, paste it as RAZORPAY_WEBHOOK_SECRET>
#        Events  payment.captured, payment.failed, payment.authorized,
#                order.paid, refund.created, refund.processed, refund.failed
#   4. Go live: swap the test keys for live keys and re-add the webhook on the live tab.
#
# 'auto' = Razorpay when the keys below are set, mock otherwise. Force with 'razorpay'/'mock'.
PAYMENT_PROVIDER=auto
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
# Shown on the checkout sheet the customer sees.
PAYMENT_BRAND_NAME=Marketplace
PAYMENT_BRAND_LOGO=
