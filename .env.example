# ---- Backend ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Mongo / Redis
MONGO_URI=mongodb://localhost:27017/marketplace
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# CORS origins
WEB_ORIGIN=http://localhost:4200
ADMIN_ORIGIN=http://localhost:4300

# Payments — Razorpay (India). Blank keys = keyless mock gateway in dev.
# Full setup notes in backend/.env.example and docs/05-PAYMENTS.md.
PAYMENT_PROVIDER=auto
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
PAYMENT_BRAND_NAME=Marketplace
EMAIL_PROVIDER=console
RESEND_API_KEY=
STORAGE_PROVIDER=local
